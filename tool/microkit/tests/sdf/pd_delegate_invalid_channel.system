<system>

    <protection_domain name="loader" priority="25" delegatee="true" >
        <program_image path="loader.elf" />
        <template name="loadee" id="0" priority="20" allow_delegation="false" >
        </template>
    </protection_domain>

    <protection_domain name="server" priority="25" >
        <program_image path="server.elf" />
    </protection_domain>

    <channel>
        <end pd="server" id="0" />
        <end pd="loadee" id="0" delegated="true" />
    </channel>

</system>
