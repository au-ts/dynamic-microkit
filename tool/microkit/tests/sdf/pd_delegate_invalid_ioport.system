<system>

    <protection_domain name="loader" priority="25" >
        <program_image path="loader.elf" />
        <template name="loadee" id="0" priority="20">
            <ioport id="0" addr="0x3f8" size="8" delegated="true" />
        </template>
    </protection_domain>

</system>
