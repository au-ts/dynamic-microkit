<system>
    <memory_region name="shared" size="0x40000" />

    <protection_domain name="loader" priority="25" delegatee="false" >
        <program_image path="loader.elf" />
        <map mr="shared" vaddr="0xC00000" perms="rw" cached="true" />
        <template name="loadee" id="0" priority="20">
            <map mr="shared" vaddr="0x20000" perms="rwx" cached="true" delegated="true" />
        </template>
    </protection_domain>

</system>